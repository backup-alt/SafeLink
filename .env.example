# Local only. Railway uses service Variables, never this file.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_OUTPUT_TOKENS=1500
# Optional OpenAI provider; select AI_PROVIDER=openai explicitly to use it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=2500
SAFELINK_CHAT_REQUESTS_PER_MINUTE=6
SAFELINK_CHAT_DAILY_REQUESTS=100
SAFELINK_CHAT_MAX_TURNS=20
SAFELINK_CHAT_MAX_TOOL_ROUNDS=5
SAFELINK_CHAT_MAX_CONCURRENT=3
# Optional existing settings; preserve your own values when editing .env.
# COPERNICUSMARINE_SERVICE_USERNAME=
# COPERNICUSMARINE_SERVICE_PASSWORD=
# HF_DATASET_REPO=
# HF_TOKEN=
# Optional: a SEPARATE PRIVATE dataset for opt-in chat archive. Never use the public ocean repository.
# HF_CHAT_DATASET_REPO=Sherwin-Aniesh/SafeLink-Chats
# HF_CHAT_TOKEN=
# HF_CHAT_TOKEN may be omitted if HF_TOKEN has write permission to the private chat dataset.
# SAFELINK_AUTO_REFRESH=true
# SAFELINK_REFRESH_TOKEN=
