# Local only. Railway uses service Variables, never this file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=2500
ORCA_CHAT_REQUESTS_PER_MINUTE=6
ORCA_CHAT_DAILY_REQUESTS=100
ORCA_CHAT_MAX_TURNS=20
ORCA_CHAT_MAX_TOOL_ROUNDS=5
ORCA_CHAT_MAX_CONCURRENT=3
